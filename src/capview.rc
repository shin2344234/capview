// CapView.exe resources. Resource 101 is capview-camera.dll, the CapView Camera filter. build.bat
// builds it into obj first, and CapView writes it out to %LOCALAPPDATA%\CapView when the camera is on.
101 RCDATA "obj/capview-camera.dll"

// The app icon, drawn by tools/make-icon.py. Explorer shows the lowest numbered icon, so it's 1.
1 ICON "src/capview.ico"
